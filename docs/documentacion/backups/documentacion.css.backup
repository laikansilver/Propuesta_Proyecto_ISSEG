/* Container principal */
.doc-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

/* Search Section */
.doc-search-section {
    margin-bottom: 2rem;
}

.search-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
}

.search-bar:focus-within {
    box-shadow: 0 4px 16px rgba(106, 17, 203, 0.2);
    transform: translateY(-2px);
}

.search-bar svg {
    width: 20px;
    height: 20px;
    color: #666;
}

.search-bar input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    color: #333;
}

.search-bar input::placeholder {
    color: #999;
}

/* Doc Navigation */
.doc-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
}

.doc-nav-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    font-weight: 500;
    color: #666;
    white-space: nowrap;
}

.doc-nav-btn svg {
    width: 20px;
    height: 20px;
}

.doc-nav-btn:hover {
    border-color: #6a11cb;
    color: #6a11cb;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(106, 17, 203, 0.2);
}

.doc-nav-btn.active {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    border-color: transparent;
    color: white;
    box-shadow: 0 4px 12px rgba(106, 17, 203, 0.3);
}

/* Documentation Content */
.doc-content {
    background: white;
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.doc-section {
    display: none;
}

.doc-section.active {
    display: block;
    animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.doc-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid #6a11cb;
}

/* Doc Cards */
.doc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.doc-card {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.3s ease;
}

.doc-card:hover {
    border-color: #6a11cb;
    box-shadow: 0 6px 20px rgba(106, 17, 203, 0.15);
    transform: translateY(-4px);
}

.doc-card-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
}

.doc-card-icon svg {
    width: 28px;
    height: 28px;
    color: white;
}

.doc-card-icon.developer {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
}

.doc-card-icon.pm {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.doc-card-icon.client {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.doc-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 0.75rem;
}

.doc-card > p {
    color: #666;
    line-height: 1.6;
    margin-bottom: 1rem;
}

.btn-expand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-expand svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
}

.btn-expand:hover {
    box-shadow: 0 4px 12px rgba(106, 17, 203, 0.4);
    transform: translateY(-2px);
}

.btn-expand.active svg {
    transform: rotate(180deg);
}

.doc-card-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    margin-top: 0;
}

.doc-card-content.show {
    max-height: 1000px;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid #e0e0e0;
}

.doc-card-content h4 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2d3748;
    margin: 1.5rem 0 1rem 0;
}

.doc-card-content h4:first-child {
    margin-top: 0;
}

.doc-card-content ol,
.doc-card-content ul {
    padding-left: 1.5rem;
    line-height: 1.8;
    color: #555;
}

.doc-card-content li {
    margin-bottom: 0.75rem;
}

.doc-card-content strong {
    color: #2d3748;
    font-weight: 600;
}

/* Doc Badges */
.doc-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-right: 0.5rem;
}

.doc-badge.pendiente {
    background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
    color: #2d3436;
}

.doc-badge.en-desarrollo {
    background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
    color: white;
}

.doc-badge.completada {
    background: linear-gradient(135deg, #55efc4 0%, #00b894 100%);
    color: white;
}

.doc-badge.urgente {
    background: linear-gradient(135deg, #ff7675 0%, #d63031 100%);
    color: white;
}

/* API Section */
.api-section {
    margin-bottom: 2.5rem;
}

.api-section h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 1rem;
}

.api-section > p {
    color: #666;
    line-height: 1.6;
    margin-bottom: 1.5rem;
}

/* Code Blocks */
.code-block {
    background: #1e1e1e;
    border-radius: 8px;
    overflow: hidden;
    margin: 1.5rem 0;
}

.code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: #2d2d2d;
    border-bottom: 1px solid #3d3d3d;
}

.code-language {
    color: #61dafb;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-copy {
    padding: 0.375rem 0.875rem;
    background: #4a4a4a;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.3s ease;
}

.btn-copy:hover {
    background: #6a11cb;
}

.code-block pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
}

.code-block code {
    color: #d4d4d4;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.6;
}

/* API Methods */
.api-method {
    background: #f8f9fa;
    border-left: 4px solid #6a11cb;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

.api-method-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
}

.method-type {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.method-type.get {
    background: #00b894;
    color: white;
}

.method-type.post {
    background: #0984e3;
    color: white;
}

.method-type.put {
    background: #fdcb6e;
    color: #2d3436;
}

.api-method-header code {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2d3748;
}

.api-method > p {
    color: #666;
    line-height: 1.6;
    margin-bottom: 1rem;
}

/* Flow Cards */
.flow-card {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
}

.flow-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 1.5rem;
}

.flow-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
}

.flow-step {
    flex: 1;
    min-width: 180px;
    text-align: center;
    padding: 1.5rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
}

.flow-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(106, 17, 203, 0.15);
}

.flow-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 1rem auto;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.flow-icon svg {
    width: 30px;
    height: 30px;
    color: white;
}

.flow-step h4 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 0.75rem;
}

.flow-step p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
}

.flow-arrow {
    font-size: 2rem;
    color: #6a11cb;
    font-weight: bold;
}

/* Status Flow */
.status-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
}

.status-step {
    text-align: center;
    padding: 1.5rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    width: 100%;
    max-width: 400px;
}

.status-step p {
    color: #666;
    margin-top: 0.75rem;
    font-size: 0.95rem;
}

.flow-arrow-down {
    font-size: 2rem;
    color: #6a11cb;
    font-weight: bold;
}

.status-note {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    margin-top: 1.5rem;
    color: #856404;
    line-height: 1.6;
}

.status-note strong {
    font-weight: 600;
}

/* FAQ Section */
.faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.faq-item {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.faq-item:hover {
    border-color: #6a11cb;
    box-shadow: 0 4px 12px rgba(106, 17, 203, 0.1);
}

.faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 600;
    color: #2d3748;
    transition: all 0.3s ease;
}

.faq-question:hover {
    color: #6a11cb;
}

.faq-question svg {
    width: 20px;
    height: 20px;
    color: #666;
    transition: transform 0.3s ease;
    flex-shrink: 0;
}

.faq-item.active .faq-question svg {
    transform: rotate(180deg);
    color: #6a11cb;
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
}

.faq-item.active .faq-answer {
    max-height: 600px;
}

.faq-answer > * {
    padding: 0 1.5rem 1.5rem 1.5rem;
}

.faq-answer p {
    color: #666;
    line-height: 1.8;
    margin-bottom: 1rem;
}

.faq-answer ol,
.faq-answer ul {
    padding-left: 3rem;
    line-height: 1.8;
    color: #555;
}

.faq-answer li {
    margin-bottom: 0.75rem;
}

.faq-answer strong {
    color: #2d3748;
    font-weight: 600;
}

.faq-answer em {
    color: #999;
    font-style: italic;
}

/* Responsive Design */
@media (max-width: 768px) {
    .doc-container {
        padding: 1rem;
    }

    .doc-content {
        padding: 1.5rem;
    }

    .doc-title {
        font-size: 1.5rem;
    }

    .doc-cards {
        grid-template-columns: 1fr;
    }

    .flow-diagram {
        flex-direction: column;
    }

    .flow-arrow {
        transform: rotate(90deg);
    }

    .doc-nav {
        gap: 0.5rem;
    }

    .doc-nav-btn {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
    }

    .search-bar {
        padding: 0.875rem 1.25rem;
    }
}

@media (max-width: 480px) {
    .doc-nav-btn span {
        display: none;
    }

    .doc-nav-btn {
        padding: 0.75rem;
    }
}
